# Where enquiries should be delivered. Comma-separate multiple inboxes.
MAIL_TO=

# Sender shown in the inbox. For Gmail SMTP this defaults to SMTP_USER.
# For Resend testing use: Subhashree Website <onboarding@resend.dev>
# For Resend with a verified domain use: Subhashree Website <hello@yourdomain.com>
MAIL_FROM=

# Optional reply-to override. Enquiries already reply to the visitor's address.
# REPLY_TO=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://shibu-patil.github.io,http://localhost:5173,http://127.0.0.1:5173

# ——— Option A: Resend (recommended if you have a domain) ———
RESEND_API_KEY=

# ——— Option B: SMTP (Gmail app password, Brevo, Zoho, etc.) ———
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Local testing only: log enquiries instead of sending them.
# MAIL_DRY_RUN=true
