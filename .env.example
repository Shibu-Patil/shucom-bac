# Where enquiries should be delivered. Comma-separate multiple inboxes.
MAIL_TO=

# Sender shown in the inbox. For Gmail SMTP this defaults to SMTP_USER.
# For Resend testing use: Subhashree Website <onboarding@resend.dev>
# For Resend with a verified domain use: Subhashree Website <hello@yourdomain.com>
MAIL_FROM=

# Optional reply-to override. Enquiries already reply to the visitor's address.
# REPLY_TO=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://shibu-patil.github.io,http://localhost:5173,http://127.0.0.1:5173

# ——— Option A: Resend (recommended for production) ———
RESEND_API_KEY=

# ——— Option B: SMTP (Gmail app password, Brevo, Zoho, etc.) ———
# Render blocks outbound ports 25/465/587 on free web services, so SMTP will
# time out there. Use Resend or FormSubmit when deploying on the free plan.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ——— Option C: FormSubmit (zero-signup fallback) ———
# Deliver enquiries through https://formsubmit.co. The first submission triggers
# a one-time "Activate Form" email to this address; click it once and you are live.
FORMSUBMIT_TO=

# Local testing only: log enquiries instead of sending them.
# MAIL_DRY_RUN=true
