# Inbox that receives the enquiries.
MAIL_TO=

# The Gmail account that sends the mail.
SMTP_USER=

# Gmail App Password (16 characters, no spaces). NOT your normal password.
SMTP_PASS=

# Optional. Defaults to smtp.gmail.com:465.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Sites allowed to call this API.
CORS_ORIGINS=https://shibu-patil.github.io,http://localhost:5173,http://127.0.0.1:5173
