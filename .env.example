# Inbox that receives the enquiries.
MAIL_TO=

# Resend API key (resend.com). Required for sending.
RESEND_API_KEY=

# Sender shown in the inbox. Leave empty to use Resend's test sender.
MAIL_FROM=

# Sites allowed to call this API.
CORS_ORIGINS=https://shibu-patil.github.io,http://localhost:5173,http://127.0.0.1:5173
