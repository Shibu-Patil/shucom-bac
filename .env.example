# Inbox that receives the enquiries. Required.
MAIL_TO=

# Browser origins allowed to call this API.
CORS_ORIGINS=https://shibu-patil.github.io,http://localhost:5173,http://127.0.0.1:5173

# Optional. With a Resend key the API uses Resend instead of FormSubmit.
# RESEND_API_KEY=

# Optional. Uncomment only if you prefer SMTP over FormSubmit.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=

# Optional. FormSubmit recipient; defaults to MAIL_TO.
# FORMSUBMIT_TO=
